{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Dados do perfil profissional e configurações do usuário",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "cnpj": { "type": "string" },
        "warranty": { "type": "string" },
        "favorites": { "type": "array", "items": { "type": "string" } },
        "isPremium": { "type": "boolean" },
        "deviceId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["updatedAt"]
    },
    "Quote": {
      "title": "Quote",
      "description": "Orçamento profissional de serviços",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "cliente": { "type": "string" },
        "telefone": { "type": "string" },
        "contatoAlt": { "type": "string" },
        "clientDoc": { "type": "string" },
        "clientAddress": { "type": "string" },
        "data": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["aprovado", "pendente", "cancelado"] },
        "warranty": { "type": "string" },
        "deviceId": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "cliente", "items", "total"]
    }
  },
  "firestore": {
    "/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Coleção central de todos os orçamentos emitidos"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dados do perfil profissional, empresa e preferências"
    },
    "/users/{userId}/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Coleção de orçamentos vinculados ao usuário autenticado"
    }
  }
}
