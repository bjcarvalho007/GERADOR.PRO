rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar de autenticação
    function isSignedIn() {
      return request.auth != null;
    }

    // Coleção principal de Orçamentos
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // Coleção de Perfis Profissionais e Configurações
    match /users/{userId} {
      allow read, write: if true;

      // Subcoleção de Orçamentos do Usuário
      match /quotes/{quoteId} {
        allow read, write: if true;
      }
    }

    // Coleção de Teste de Conexão
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
